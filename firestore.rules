rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(party) {
      return isSignedIn() && party.ownerId == request.auth.uid;
    }

    match /watchParty/{partyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.partyName is string
        && request.resource.data.partyName.size() > 0
        && request.resource.data.partyName.size() <= 60
        && request.resource.data.memberCount == 1
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.films is list
        && request.resource.data.films.size() > 0
        && request.resource.data.films.size() <= 20
        && request.resource.data.maxMembers >= 2
        && request.resource.data.maxMembers <= 8;

      allow update: if isOwner(resource.data)
        || (isSignedIn()
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberIds'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= resource.data.maxMembers
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasAll([request.auth.uid])
          && !resource.data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1);

      allow delete: if isOwner(resource.data);

      match /members/{memberId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.isFinished == false
          && request.resource.data.preferredFilms is list
          && request.resource.data.preferredFilms.size() == 0
          && getAfter(/databases/$(database)/documents/watchParty/$(partyId))
            .data.memberIds.hasAll([request.auth.uid]);

        allow update: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.preferredFilms is list
          && request.resource.data.preferredFilms.size() <= 20
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredFilms', 'isFinished', 'finishedAt']);

        allow delete: if isSignedIn()
          && (memberId == request.auth.uid
            || isOwner(get(/databases/$(database)/documents/watchParty/$(partyId)).data));
      }
    }
  }
}
