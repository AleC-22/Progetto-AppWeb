rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(party) {
      return isSignedIn() && party.ownerId == request.auth.uid;
    }

    function partyData(partyId) {
      return get(/databases/$(database)/documents/watchParty/$(partyId)).data;
    }

    function isPartyMember(partyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/watchParty/$(partyId)/members/$(request.auth.uid));
    }

    match /watchParty/{partyId} {
      // The document ID is the invite code. Any signed-in user who knows the
      // code can read the room, but only the owner can list their rooms.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.partyName is string
        && request.resource.data.partyName.size() > 0
        && request.resource.data.partyName.size() <= 60
        && request.resource.data.memberCount == 1
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.finishedCount == 0
        && request.resource.data.films is list
        && request.resource.data.films.size() > 0
        && request.resource.data.films.size() <= 20;

      allow update: if isOwner(resource.data)
        || (isSignedIn()
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberIds'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasAll([request.auth.uid])
          && !resource.data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
        // A member increments finishedCount once, in the same transaction that
        // flips their own member document from not finished to finished.
        || (isSignedIn()
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finishedCount'])
          && request.resource.data.finishedCount == resource.data.get('finishedCount', 0) + 1
          && request.resource.data.finishedCount <= resource.data.memberCount
          && get(/databases/$(database)/documents/watchParty/$(partyId)/members/$(request.auth.uid))
            .data.isFinished == false
          && getAfter(/databases/$(database)/documents/watchParty/$(partyId)/members/$(request.auth.uid))
            .data.isFinished == true);

      allow delete: if isOwner(resource.data);

      match /members/{memberId} {
        // A user can always read their own member document, even before it
        // exists (needed by the join transaction). Members and the owner can
        // read the whole member list of the room. Collection-group queries are
        // rejected because the party path is not fully bound.
        allow get: if isSignedIn()
          && (memberId == request.auth.uid
            || isPartyMember(partyId)
            || isOwner(partyData(partyId)));

        allow list: if isPartyMember(partyId) || isOwner(partyData(partyId));

        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.isFinished == false
          && request.resource.data.preferredFilms is list
          && request.resource.data.preferredFilms.size() == 0
          && getAfter(/databases/$(database)/documents/watchParty/$(partyId))
            .data.memberIds.hasAll([request.auth.uid]);

        allow update: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && resource.data.isFinished == false
          && request.resource.data.isFinished == true
          && request.resource.data.preferredFilms is list
          && request.resource.data.preferredFilms.size() <= 20
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredFilms', 'isFinished', 'finishedAt']);

        // Only the owner deletes member documents (when deleting the room), so
        // memberCount and finishedCount cannot drift from the actual members.
        allow delete: if isOwner(partyData(partyId));
      }
    }
  }
}
