# Firebase (Project settings > General > Your apps)
VITE_Firebase_apiKey=
VITE_Firebase_authDomain=
VITE_Firebase_projectId=
VITE_Firebase_storageBucket=
VITE_Firebase_messagingSenderId=
VITE_Firebase_appId=
VITE_Firebase_measurementId=

# TMDb API key (https://www.themoviedb.org/settings/api)
# Server-side only: used by the Vite dev proxy and the Vercel function.
# Never prefix it with VITE_, or it will end up in the browser bundle.
# Free key: non-commercial use only. Commercial use requires a TMDb agreement.
TMDB_API_KEY=

# Optional: local development
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_DEMO_MOVIES=true
