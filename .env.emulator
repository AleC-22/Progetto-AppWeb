# Local Firebase Emulator Suite profile.
# Run `npm run emulators` in another terminal, then `npm run dev:emulators`.
# No real Firebase project or TMDb key is required in this mode.
VITE_Firebase_apiKey=demo-movie-matcher
VITE_Firebase_authDomain=demo-movie-matcher.firebaseapp.com
VITE_Firebase_projectId=demo-movie-matcher
VITE_Firebase_storageBucket=demo-movie-matcher.appspot.com
VITE_Firebase_messagingSenderId=000000000000
VITE_Firebase_appId=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATORS=true
VITE_DEMO_MOVIES=true
